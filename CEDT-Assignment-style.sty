% ======================================
% Code Box
% ======================================

\newtcblisting{codingbox}[1][]{
  enhanced,
  breakable,
  colback=editorbg,
  colframe=outerborder,
  boxrule=1pt,
  left=0pt,
  right=6pt,
  top=6pt,
  bottom=6pt,
  underlay={
      \fill[gutterbg]
      (frame.north west)
      rectangle
      ([xshift=24pt]frame.south west);
    },
  overlay={
      % Vertical separator
      \draw[outerborder, line width=0.5pt]
      ([xshift=24pt]frame.north west) --
      ([xshift=24pt]frame.south west);
    },
  listing only,
  listing engine=listings,
  % tcolorbox's default "listing file" is a bare `\jobname.listing` (no
  % path). Under this repo's per-project -aux-directory=.build setup, kpathsea
  % resolves that bare filename against .build/ *before* the current
  % directory, so it keeps re-reading the very first .build/*.listing ever
  % written there instead of the fresh copy tcolorbox writes to cwd on every
  % run -- the box silently shows stale (e.g. leftover template) code no
  % matter how many times you rebuild. An explicit ./-prefixed, per-box
  % filename bypasses that search-path ambiguity and always resolves to cwd.
  listing file={./\jobname-codingbox-\thetcblistingcount.listing},
  listing options={
      style=notepadstyle,
      #1
    }
}

% =========================== Figures ===========================
% Usage: \fig[width]{path}{caption}{label}
%   width defaults to 0.7\linewidth; the label is prefixed with "fig:"
%   \fig*[width]{path}{caption}{label} drops the "Figure N:" caption/label
%   entirely (just the centered image) -- caption/label are still required
%   syntactically but are ignored, so pass {} for both when starred.
\NewDocumentCommand{\fig}{s O{0.7\linewidth} m m m}{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#2]{#3}
    \IfBooleanF{#1}{%
      \caption{#4}%
      \label{fig:#5}%
    }%
  \end{figure}%
}

% =========================== Tables ===========================
% Usage: \begin{simpletable}{<colspec>}{<caption>}{<label>}
%   write rows as normal (add \midrule after the header row yourself);
%   the label is prefixed with "tab:"
\NewDocumentEnvironment{simpletable}{m m m}{%
  \begin{table}[H]
    \centering
    \begin{tabular}{#1}
      \toprule
      }{%
      \bottomrule
    \end{tabular}
    \caption{#2}
    \label{tab:#3}
  \end{table}
}

% =========================== Multiple choice ===========================
% Usage: \choices[<num choices>]{choice A, choice B, choice C, choice D}
%   <num choices> is optional and defaults to 4; it should match the number
%   of comma-separated choices actually given. A mismatch only prints a
%   PackageWarning, it still typesets whatever was given. If a choice needs
%   a literal comma in it, wrap that choice in braces, e.g. {1{,}000 baht}.
%   The layout automatically switches between 4, 2, or 1 columns depending
%   on how wide the longest choice is, so short choices ("True", "False",
%   ...) sit four to a row, medium ones wrap to two, and long ones (full
%   sentences) go one per line. It never uses more columns than there are
%   choices.
\newlength{\choicewidth}
\newlength{\choicemaxwidth}
\newcounter{choiceindex}
\newcounter{choicetotal}
\newcounter{choicecols}
\newcounter{choicecursor}
\newcommand{\choicerows}{}
\newcommand{\choicelabeltmp}{}

\NewDocumentCommand{\choices}{O{4} m}{%
  \begingroup
  \vspace{6pt}%
  % ---- Pass 1: count the choices and find the widest one ----
  \setcounter{choiceindex}{0}%
  \setlength{\choicemaxwidth}{0pt}%
  \renewcommand{\do}[1]{%
    \stepcounter{choiceindex}%
    \settowidth{\choicewidth}{\Alph{choiceindex}.~##1}%
    \ifdim\choicewidth>\choicemaxwidth
      \setlength{\choicemaxwidth}{\choicewidth}%
    \fi
  }%
  \docsvlist{#2}%
  \setcounter{choicetotal}{\value{choiceindex}}%
  \ifnum\value{choicetotal}=#1\else
    \PackageWarning{choices}{Got \arabic{choicetotal}\space choice(s) but #1 were expected}%
  \fi
  % ---- Pick 4 / 2 / 1 columns from the widest choice ----
  % Compare against the *real* per-column width tabularx will end up with
  % (total width minus the \tabcolsep gaps between columns), not a flat
  % fraction of \linewidth, and leave a 10% safety margin. Comparing
  % against the flat fraction let the widest choice "just barely" pass the
  % check and then not actually fit once \tabcolsep overhead was taken out,
  % producing a marginal Overfull \hbox on nearly every call.
  \setlength{\choicewidth}{\dimexpr(\linewidth-6\tabcolsep)/4\relax}%
  \ifdim\choicemaxwidth<0.9\choicewidth
    \setcounter{choicecols}{4}%
  \else
    \setlength{\choicewidth}{\dimexpr(\linewidth-2\tabcolsep)/2\relax}%
    \ifdim\choicemaxwidth<0.9\choicewidth
      \setcounter{choicecols}{2}%
    \else
      \setcounter{choicecols}{1}%
    \fi
  \fi
  \ifnum\value{choicecols}>\value{choicetotal}%
    \setcounter{choicecols}{\value{choicetotal}}%
  \fi
  % ---- Pass 2: pre-build the row content as inert text ----
  % (tabularx typesets X-column content twice to size it, so anything with
  % side effects -- counters, \ifnum -- has to be resolved before it gets
  % there; \choicerows ends up as a plain string of "label & label \\ ...")
  \renewcommand{\choicerows}{}%
  \setcounter{choiceindex}{0}%
  \setcounter{choicecursor}{0}%
  \renewcommand{\do}[1]{%
    \stepcounter{choiceindex}%
    \ifnum\value{choiceindex}=1\relax
    \else
      \ifnum\value{choicecursor}=0\relax
        \appto{\choicerows}{\\}%
      \else
        \appto{\choicerows}{&}%
      \fi
    \fi
    \edef\choicelabeltmp{\Alph{choiceindex}.~}%
    \eappto{\choicerows}{\choicelabeltmp}%
    \appto{\choicerows}{##1}%
    \stepcounter{choicecursor}%
    \ifnum\value{choicecursor}=\value{choicecols}%
      \setcounter{choicecursor}{0}%
    \fi
  }%
  \docsvlist{#2}%
  % ---- Pass 3: typeset the pre-built rows in a tabularx grid ----
  % \par\noindent has to sit directly against \begin{tabularx} (nothing, not
  % even a comment line, between them) -- \noindent opens horizontal mode,
  % and anything typeset in between before the environment forces its own
  % \par left stray material sitting in that same (never-broken) paragraph,
  % which showed up as a phantom Overfull \hbox once the table finally
  % forced the line to break.
  \par\noindent\begin{tabularx}{\linewidth}{@{}*{\value{choicecols}}{>{\raggedright\arraybackslash}X}@{}}%
    \choicerows
  \end{tabularx}%
  \vspace{4pt}%
  \endgroup
}

% =========================== Appendix inclusion ===========================

% Appendix title page style
\fancypagestyle{appendixtitle}{
  \fancyhf{}
  \fancyhead[L]{\textbf{\currentsubject}}
  \fancyhead[R]{\thepage}
  \fancyfoot[C]{\textbf{\currentfooter}}
  \renewcommand{\footrulewidth}{0.4pt}
}

% Appendix counter
\newcounter{myappendix}

\newcommand{\myappendix}[2]{%
  % #1 = path/to/file.pdf
  % #2 = appendix title (PDF name / description)

  \refstepcounter{myappendix}

  % ---------- Title page ----------
  \clearpage
  \thispagestyle{appendixtitle}

  \vspace*{\fill}
  \begin{center}
    {\Huge\bfseries APPENDIX~\arabic{myappendix}\par}
    \vspace{1.5em}
    {\huge #2\par}
  \end{center}
  \vspace*{\fill}

  \clearpage

  % ---------- PDF content ----------
  \includepdf[
    pages=-,
    pagecommand={},
  ]{#1}
}

