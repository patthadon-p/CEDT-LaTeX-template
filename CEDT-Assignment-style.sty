\newcommand{\currentsubject}{}

% \subject with no argument falls back to \CourseCode/\CourseName, which must
% be defined beforehand (normally by \input-ing course-config.tex — see
% course-config.tex.example in this template repo).
\NewDocumentCommand{\subject}{o}{%
  \IfNoValueTF{#1}
    {%
      \ifdefined\CourseCode
        \renewcommand{\currentsubject}{\CourseCode\space - \CourseName}%
      \else
        \PackageError{CEDT-Assignment-style}{\string\subject\space needs \string\CourseCode/\string\CourseName\space to be defined (input course-config.tex before calling \string\subject) or an explicit argument}{}%
      \fi
    }
    {\renewcommand{\currentsubject}{#1}}%
  \fancyhead[L]{\textbf{\currentsubject}}%
}

\newcommand{\currentfooter}{}

\newcommand{\setfooter}[1]{%
  \renewcommand{\currentfooter}{#1}%
  \fancyfoot[C]{\textbf{#1}}%
}

