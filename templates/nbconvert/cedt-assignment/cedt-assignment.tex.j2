((*- extends 'latex/index.tex.j2' -*))

%===============================================================================
% Pulls in the shared CEDT-Assignment-style.sty (fonts, a4paper + 3cm margins,
% header/footer, problem/solution/codingbox environments) plus the subject's
% own course-config.tex, so notebook-exported PDFs
% (`jupyter nbconvert --to pdf --template cedt-assignment ...`, or `make nb-pdf`)
% look consistent with the LaTeX assignment write-ups. Both files are vendored
% via git submodule / owned per-subject-repo -- see this template repo's
% README.md for how they're located below.
%===============================================================================

((*- block docclass -*))
\documentclass[a4paper, 10pt]{article}
((*- endblock docclass -*))

((*- block packages -*))
    % Match the 9pt body-text size used in
    % templates/template/assignment-template.tex: rescale every relative size
    % (\normalsize, \small, \large, ...) here, before anything else is loaded,
    % so headers/footers/body text/code blocks all shrink together.
    \usepackage{scrextend}
    \changefontsizes{9pt}
    %
    % style_jupyter.tex.j2 (pulled in via super(), below) does its own
    % `\usepackage[breakable]{tcolorbox}`, and CEDT-Assignment-style does
    % `\usepackage[most]{tcolorbox}` -- two \usepackage{tcolorbox} calls with
    % different option strings is a hard "Option clash" error regardless of
    % which one runs first or whether one option set is a logical subset of
    % the other. LaTeX's clash check is a literal *string* comparison of
    % accumulated option tokens -- it has no idea "most" implies "breakable"
    % as a tcolorbox library, so passing only "most" here still leaves a
    % literal "breakable" clash. \PassOptionsToPackage queues both literal
    % tokens before tcolorbox is actually loaded by either call, so whichever
    % \usepackage{tcolorbox} fires first absorbs both, and the second
    % (redundant) call is then a true subset of what's already recorded --
    % no clash.
    \PassOptionsToPackage{most,breakable}{tcolorbox}
    % Same clash, same fix: base.tex.j2 loads `\usepackage[inline]{enumitem}`
    % while CEDT-Assignment-style loads plain `\usepackage{enumitem}`.
    \PassOptionsToPackage{inline}{enumitem}
    %
    % Third clash in the same family, and this one is fatal rather than
    % cosmetic: base.tex.j2 does `\usepackage{enumerate}` (the old tools
    % package) *after* this block has already pulled enumitem in through
    % CEDT-Assignment-style. enumerate.sty redefines \enumerate but leaves
    % \endenumerate alone, so `\begin{enumerate}` runs enumerate.sty's code
    % while `\end{enumerate}` is still enumitem's \enit@endenumerate -- which
    % expands \enit@after, a macro only enumitem's own \enumerate ever
    % defines. Every numbered list in a markdown cell then dies with
    % "! Undefined control sequence. \enit@endenumerate ->\enit@after".
    % Bullet lists pair up fine either way, which is why this only bites on
    % notebooks that happen to use "1." lists. Loading enumerate.sty here,
    % *before* the style file, restores stock nbconvert's ordering: enumitem
    % is loaded last and defines \enumerate and \endenumerate as a matching
    % pair, and base.tex.j2's later \usepackage{enumerate} is a no-op.
    \usepackage{enumerate}
    %
    % Same shape of problem, different package: CEDT-Assignment-style loads
    % arydshln, and arydshln only knows how to coexist with array/longtable if
    % those are already loaded when it patches \\ (\adl@@cr). base.tex.j2
    % loads longtable/booktabs/array further down, i.e. too late, so a pandoc
    % markdown table -- always a longtable with booktabs rules -- blows up on
    % its \midrule with "! Undefined control sequence. \adl@@cr ...\adl@rowsL".
    % Pulling array and longtable in here, ahead of the style file, lets
    % arydshln patch them properly; base.tex.j2's own copies are then no-ops.
    \usepackage{array}
    \usepackage{longtable}
    %
    % nbconvert's PDFExporter always compiles in an isolated temp directory
    % (see nbconvert/exporters/pdf.py), so a relative path -- to either the
    % submodule's CEDT-Assignment-style.sty or the subject repo's own
    % course-config.tex -- can never resolve here no matter how it's written:
    % the temp dir has no relation to where the notebook, the submodule, or
    % course-config.tex actually live. Instead rely on kpathsea/TEXINPUTS:
    % `make nb-pdf` exports TEXINPUTS covering both the subject repo root
    % (for course-config.tex) and vendor/template/ (for the .sty), so these
    % bare-filename lookups find both regardless of how deeply the notebook
    % is nested (assignment-XX/, assignment-XX/code/, ...). Running nbconvert
    % by hand instead of via `make nb-pdf`? Set TEXINPUTS the same way first
    % -- see this template repo's README.md.
    \makeatletter
    \IfFileExists{course-config.tex}
      {\input{course-config}}
      {\PackageWarning{cedt-assignment}{course-config.tex not found on TEXINPUTS -- \string\subject\space below will error. export TEXINPUTS="<subject repo root>:$TEXINPUTS" before running jupyter nbconvert}}
    \IfFileExists{CEDT-Assignment-style.sty}
      {\usepackage{CEDT-Assignment-style}}
      {\PackageWarning{cedt-assignment}{CEDT-Assignment-style.sty not found on TEXINPUTS -- export TEXINPUTS="<subject repo root>:<subject repo root>/vendor/template:$TEXINPUTS" before running jupyter nbconvert}}
    \makeatother
    ((( super() )))
    %
    % amsmath ships bmatrix/pmatrix/... with room for 10 columns. A statevector
    % printed by qiskit's array_to_latex is one row of 2^n entries (64 for six
    % qubits), so anything past the 10th column errors with "Extra alignment tab
    % has been changed to \\cr". The counter only sizes the alignment preamble
    % amsmath builds, so raising it costs nothing when the matrices are small.
    \setcounter{MaxMatrixCols}{128}
((*- endblock packages *))

((*- block margins *))
    % CEDT-Assignment-style already sets a4paper + 3cm margins via \geometry;
    % skip nbconvert's default 1in \geometry call so it doesn't override that.
((*- endblock margins *))

((*- block predoc *))
    \subject
    ((( super() )))
((*- endblock predoc *))


((= ==========================================================================
    A text/latex output is copied into the document verbatim by the stock
    template, which assumes it is valid LaTeX. Output produced for Jupyter's
    MathJax often isn't. qiskit's array_to_latex, for one, returns
    "$$\n\n\begin{bmatrix}...": MathJax ignores the blank line, but to LaTeX it
    is a \par inside display math -- "! Missing $ inserted." and the build dies.
    Those same arrays are also much wider than the text block (a 6-qubit
    statevector is one row of 64 columns), so even once it compiles it runs off
    the page.

    So, for outputs that are display math ($$...$$), drop the blank lines and
    re-wrap the body as inline math inside \adjustbox (adjustbox is loaded by
    base.tex.j2), which shrinks it to \linewidth only when it would otherwise
    overflow and leaves normal-sized math alone. Anything that is not display
    math -- a tabular from pandas' to_latex, say -- is passed through untouched.

    Jinja comments (((= =))) rather than % ones: the whitespace-trimming tags
    below would otherwise pull \begin{center} up onto the end of a % line and
    comment it out.
========================================================================== =))
((*- block data_latex -*))
((*- set _tex = output.data['text/latex'] | strip_files_prefix -*))
((*- set _body = _tex.strip() -*))
((*- if _body.startswith('$$') and _body.endswith('$$') -*))
((*- set _math = _body[2:-2].split('\n') | map('trim') | reject('equalto', '') | join(' ') *))

\begin{center}
\adjustbox{max width=\linewidth}{$\displaystyle ((( _math )))$}
\end{center}
((*- else *))
((( _tex )))
((*- endif *))
((*- endblock data_latex *))
